{
  "description": "Offers to set up project memory the first time Claude opens a project without it, and keeps the plugin up to date",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/offer-setup.sh",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/self-update.sh\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
